        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전 녹음을 아직 저장하는 중입니다. 잠시 기다린 후 다시 시작하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上一段录音仍在保存中，请稍候再开始新的录音。"
