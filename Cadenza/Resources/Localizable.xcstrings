    },
    "Cadenza couldn't pause background work — nothing changed. Try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza konnte die Hintergrundaufgaben nicht pausieren. Es wurde nichts geändert. Versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza no pudo pausar el trabajo en segundo plano, por lo que no se cambió nada. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza n’a pas pu suspendre les tâches en arrière-plan. Rien n’a changé. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenzaはバックグラウンド処理を一時停止できませんでした。変更はありません。もう一度お試しください。"
