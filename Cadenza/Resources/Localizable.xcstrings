        }
      }
    },
    "The profile changed — sign out again to retry." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil wurde gewechselt. Melden Sie sich erneut ab, um es noch einmal zu versuchen."
