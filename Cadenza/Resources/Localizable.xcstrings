  "strings" : {
    "Run a paid summary evaluation?" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "运行付费摘要评测？"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有料の要約評価を実行しますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "유료 요약 평가를 실행할까요?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lancer une évaluation payante des résumés ?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenpflichtige Zusammenfassungsauswertung starten?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Ejecutar una evaluación de resúmenes de pago?"
          }
        }
