    "Link this profile's recordings to the account, or keep them separate in a new profile." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verknüpfen Sie die Aufnahmen dieses Profils mit dem Konto oder bewahren Sie sie getrennt in einem neuen Profil auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincula las grabaciones de este perfil a la cuenta o mantenlas separadas en un perfil nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associez les enregistrements de ce profil au compte, ou conservez-les séparément dans un nouveau profil."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロファイルの録音をアカウントにリンクするか、新しいプロファイルに分けて保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 프로필의 녹음을 계정에 연결하거나 새 프로필에 별도로 유지합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将此配置档案的录音关联到该账号，或保持独立、放入新的配置档案。"
          }
        }
      }
    },
    "Linking never uploads existing recordings by itself. Choose what may sync — you can change this later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Verknüpfen allein werden vorhandene Aufnahmen niemals hochgeladen. Wählen Sie aus, was synchronisiert werden darf; dies kann später in den Einstellungen geändert werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vinculación por sí sola nunca carga las grabaciones existentes. Elige qué se puede sincronizar; podrás cambiarlo más adelante en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’association seule ne téléverse jamais les enregistrements existants. Choisissez ce qui peut être synchronisé ; vous pourrez modifier ce choix ultérieurement dans Réglages."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクするだけで既存の録音がアップロードされることはありません。同期を許可する内容を選択してください。この設定は後から「設定」で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연결만으로 기존 녹음이 업로드되지는 않습니다. 동기화할 항목을 선택하세요. 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关联本身不会上传任何现有录音。请选择允许同步的内容——之后可在设置中更改。"
          }
        }
      }
    },
