        }
      }
    },
    "A verifiable backup of every recording, transcript, summary and chat — audio included. Never contains API keys or account tokens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine überprüfbare Sicherung aller Aufnahmen, Transkripte, Zusammenfassungen und Chats, einschließlich Audio. API-Schlüssel oder Konto-Token sind niemals enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una copia de seguridad verificable de todas las grabaciones, transcripciones, resúmenes y chats, incluido el audio. Nunca contiene claves de API ni tokens de cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une sauvegarde vérifiable de chaque enregistrement, transcription, résumé et chat, audio inclus. Elle ne contient jamais de clés API ni de jetons de compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての録音、文字起こし、要約、チャットを音声込みで検証可能な形式にバックアップします。APIキーやアカウントトークンは一切含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 녹음, 대화 내용, 요약, 채팅을 오디오와 함께 검증 가능한 형태로 백업합니다. API 키나 계정 토큰은 포함되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可校验的完整备份：全部录音、转录、摘要与聊天记录（含音频）。绝不包含 API key 或账号凭证。"
          }
        }
      }
    },
    "A verifiable export of every recording, transcript, summary and chat — audio included. Cadenza cannot currently import this archive. Never contains API keys or account tokens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein überprüfbarer Export aller Aufzeichnungen, Transkripte, Zusammenfassungen und Chats – einschließlich Audio. Cadenza kann dieses Archiv derzeit nicht importieren. API-Schlüssel oder Konto-Token sind niemals enthalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una exportación verificable de todas las grabaciones, transcripciones, resúmenes y chats, incluido el audio. Actualmente Cadenza no puede importar este archivo. Nunca incluye claves de API ni tokens de cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un export vérifiable de tous les enregistrements, transcriptions, résumés et chats, audio compris. Cadenza ne peut pas importer cette archive pour le moment. Il ne contient jamais de clés API ni de jetons de compte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての録音、文字起こし、要約、チャット（音声を含む）の検証可能なエクスポートです。現在、Cadenza はこのアーカイブをインポートできません。API キーやアカウントトークンは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 녹음, 전사, 요약 및 채팅(오디오 포함)의 검증 가능한 내보내기입니다. 현재 Cadenza에서는 이 아카이브를 가져올 수 없습니다. API 키나 계정 토큰은 포함되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是包含所有录音、转录、摘要和聊天（包括音频）的可验证导出。Cadenza 目前无法导入此归档。归档绝不会包含 API 密钥或账户令牌。"
          }
        }
      }
    },
    "About %@ will be written to the chosen folder." : {
