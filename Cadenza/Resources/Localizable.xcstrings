        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die automatischen Wiederherstellungssicherungen wurden gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borraron las copias de recuperación automáticas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes de récupération automatiques ont été effacées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動復旧バックアップを消去しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동 복구 백업을 지웠습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已清除自动恢复备份。"
          }
        }
      }
    },
    "Cadenza keeps up to three startup recovery copies. This action clears copies for the current profile and from earlier versions without changing your active library." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza bewahrt bis zu drei Wiederherstellungskopien vom App-Start auf. Mit dieser Aktion werden Kopien für das aktuelle Profil sowie aus früheren Versionen gelöscht, ohne die aktive Mediathek zu verändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza conserva hasta tres copias de recuperación del inicio. Esta acción borra las copias del perfil actual y de versiones anteriores sin modificar la biblioteca activa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza conserve jusqu’à trois copies de récupération créées au démarrage. Cette action efface les copies du profil actuel et celles des versions antérieures sans modifier la bibliothèque active."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenzaは起動時の復旧コピーを最大3件保持します。この操作では、使用中のライブラリを変更せずに、現在のプロファイルと以前のバージョンのコピーを消去します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza는 시작 시점의 복구 사본을 최대 3개 보관합니다. 이 작업은 활성 보관함을 변경하지 않고 현재 프로필과 이전 버전의 사본을 지웁니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza 最多保留三个启动恢复副本。此操作会清除当前配置档案及早期版本的副本，不会更改当前资料库。"
          }
        }
      }
    },
