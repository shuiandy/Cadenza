    "Microphone access is required for automatic meeting recording. Auto-record stays on and will resume once access is granted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für automatische Meeting-Aufnahmen ist Mikrofonzugriff erforderlich. Die automatische Aufnahme bleibt aktiviert und wird fortgesetzt, sobald der Zugriff gewährt wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación automática de reuniones requiere acceso al micrófono. La grabación automática permanece activada y se reanudará en cuanto concedas el acceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement automatique des réunions nécessite l’accès au microphone. L’enregistrement automatique reste activé et reprendra dès que l’accès sera autorisé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議の自動録音にはマイクへのアクセスが必要です。自動録音はオンのまま維持され、アクセスを許可すると自動的に再開されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회의 자동 녹음에는 마이크 접근 권한이 필요합니다. 자동 녹음은 켜진 상태로 유지되며 접근을 허용하면 자동으로 재개됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动录制会议需要麦克风访问权限。自动录音保持开启，将在授予权限后自动恢复。"
          }
        }
      }
    },
    "Microphone access is required for automatic meeting recording. Enable it in System Settings, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für automatische Meeting-Aufnahmen ist Mikrofonzugriff erforderlich. Aktivieren Sie ihn in den Systemeinstellungen und versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación automática de reuniones requiere acceso al micrófono. Actívalo en Ajustes del Sistema e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement automatique des réunions nécessite l’accès au microphone. Activez-le dans Réglages Système, puis réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議の自動録音にはマイクへのアクセスが必要です。システム設定で有効にしてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회의 자동 녹음에는 마이크 접근 권한이 필요합니다. 시스템 설정에서 활성화한 후 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动录制会议需要麦克风访问权限。请在“系统设置”中启用后重试。"
          }
        }
      }
    },
    "Microphone access was denied. Enable Cadenza in System Settings → Privacy & Security → Microphone." : {
