    "Live transcription disconnected. Recording continues normally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Transkription getrennt. Die Aufnahme wird normal fortgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcripción en vivo se desconectó. La grabación continúa con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
