    },
    "The profile switch was not saved — nothing changed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Profilwechsel wurde nicht gespeichert. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se guardó el cambio de perfil, por lo que no se cambió nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement de profil n’a pas été enregistré. Rien n’a changé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルの切り替えを保存できませんでした。変更はありません。"
