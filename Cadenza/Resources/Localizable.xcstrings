          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcription en direct d’Apple est traitée sur ce Mac. Aucune clé API n’est requise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple のライブ文字起こしはこの Mac 上で処理されます。API キーは不要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
