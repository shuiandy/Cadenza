          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCPサーバーを起動できませんでした。選択したポートが使用可能か確認して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
