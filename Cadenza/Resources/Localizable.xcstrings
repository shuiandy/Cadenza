          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 服务器无法启动。请检查所选端口是否可用，然后重试。"
          }
        }
      }
    },
    "Craft couldn't open the document. Make sure Craft is installed, then try again." : {
      "localizations" : {
