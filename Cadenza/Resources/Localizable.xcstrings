    "A profile change didn't finish. Quit and reopen Cadenza to continue." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Profiländerung wurde nicht abgeschlossen. Beenden und öffnen Sie Cadenza erneut, um fortzufahren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se completó un cambio de perfil. Cierra Cadenza y vuelve a abrirlo para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une modification de profil n’a pas abouti. Quittez puis rouvrez Cadenza pour continuer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルの変更が完了しませんでした。続行するにはCadenzaを終了して開き直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필 변경이 완료되지 않았습니다. 계속하려면 Cadenza를 종료한 후 다시 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
