    "Zoom could not be disconnected because its secure tokens could not be removed. Please try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom konnte nicht getrennt werden, weil die sicheren Tokens nicht entfernt werden konnten. Bitte versuchen Sie es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo desconectar Zoom porque no se pudieron eliminar sus tokens seguros. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoom n’a pas pu être déconnecté, car ses jetons sécurisés n’ont pas pu être supprimés. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セキュアトークンを削除できなかったため、Zoomとの接続を解除できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 토큰을 제거할 수 없어 Zoom 연결을 해제하지 못했습니다. 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法移除安全令牌，因此未能断开 Zoom 连接。请重试。"
          }
        }
      }
    },
