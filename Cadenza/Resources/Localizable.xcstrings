          }
        }
      }
    },
    "Your recordings move into the account profile and Local starts over empty. Nothing is uploaded by this step." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Aufnahmen werden in das Kontoprofil verschoben und „Local“ beginnt wieder leer. Bei diesem Schritt wird nichts hochgeladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grabaciones se trasladan al perfil de la cuenta y Local vuelve a empezar vacío. Este paso no carga ningún dato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos enregistrements sont déplacés vers le profil du compte et Local repart à vide. Cette étape ne téléverse rien."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音はアカウントプロファイルに移動し、ローカルプロファイルは空の状態で再開します。この手順だけでは何もアップロードされません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음이 계정 프로필로 이동하고 로컬 프로필은 빈 상태로 새로 시작됩니다. 이 단계에서는 아무것도 업로드되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音将移入账号配置档案，Local 将清空重新开始。此步骤不会上传任何内容。"
          }
        }
      }
    },
    "Your recordings will appear here after you record a meeting." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Aufnahmen werden hier angezeigt, nachdem Sie ein Meeting aufgenommen haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus grabaciones aparecerán aquí después de grabar una reunión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos enregistrements apparaîtront ici après avoir enregistré une réunion."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会議を録音すると、ここに録音が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "회의를 녹음하면 여기에 녹음이 표시됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录制会议后你的录音将出现在这里。"
          }
        }
      }
    },
    "Your session couldn't be securely cleared. Quit and reopen Cadenza, then try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Sitzung konnte nicht sicher gelöscht werden. Beenden und öffnen Sie Cadenza erneut und versuchen Sie es noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo borrar tu sesión de forma segura. Cierra Cadenza, vuelve a abrirlo e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session n’a pas pu être effacée de manière sécurisée. Quittez puis rouvrez Cadenza, et réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションを安全に消去できませんでした。Cadenzaを終了して開き直し、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션을 안전하게 지우지 못했습니다. Cadenza를 종료한 후 다시 열어 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您的会话未能安全清除。请退出并重新打开 Cadenza，然后重试。"
          }
        }
      }
    },
    "Your session expired — please sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Sitzung ist abgelaufen. Melden Sie sich erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu sesión ha caducado. Vuelve a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre session a expiré. Reconnectez-vous."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セッションの有効期限が切れました。もう一度サインインしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세션이 만료되었습니다. 다시 로그인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会话已过期，请重新登录。"
          }
        }
      }
    },
    "Your session has expired. Please sign in again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Sitzung ist abgelaufen. Melden Sie sich erneut an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
