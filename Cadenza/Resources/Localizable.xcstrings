    "Cadenza recordings exceed this limit. Review recordings or empty Trash; storage limit checks never delete active recordings automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza-Aufnahmen überschreiten dieses Limit. Prüfen Sie die Aufnahmen oder leeren Sie den Papierkorb; Speicherlimitprüfungen löschen aktive Aufnahmen niemals automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza recordings exceed this limit. Review recordings or empty Trash; storage limit checks never delete active recordings automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones de Cadenza superan este límite. Revisa las grabaciones o vacía la papelera; las comprobaciones del límite de almacenamiento nunca eliminan automáticamente grabaciones activas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements Cadenza dépassent cette limite. Vérifiez les enregistrements ou videz la corbeille ; les contrôles de limite de stockage ne suppriment jamais automatiquement les enregistrements actifs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza の録音がこの上限を超えています。録音を確認するかゴミ箱を空にしてください。ストレージ上限の確認によってアクティブな録音が自動的に削除されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza 녹음이 이 한도를 초과했습니다. 녹음을 검토하거나 휴지통을 비우세요. 저장 공간 한도 확인으로 활성 녹음이 자동 삭제되는 일은 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza 录音已超过此限制。请检查录音或清空废纸篓；存储上限检查绝不会自动删除活跃录音。"
          }
        }
      }
    },
    "Cadenza server error (%lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza-Serverfehler (%lld)."
          }
        },
        "es" : {
          "stringUnit" : {
