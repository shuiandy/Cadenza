        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza가 백그라운드 작업을 일시 중지하지 못했습니다. 변경된 내용이 없습니다. 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza 无法暂停后台工作——未做任何更改。请重试。"
          }
        }
      }
    },
    "Cadenza couldn't restart itself. The switch was undone — please quit and reopen to try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza konnte sich nicht neu starten. Der Wechsel wurde rückgängig gemacht. Beenden und öffnen Sie die App erneut, um es noch einmal zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza no pudo reiniciarse. Se deshizo el cambio; cierra la aplicación, vuelve a abrirla e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza n’a pas pu redémarrer. Le changement a été annulé. Quittez puis rouvrez l’app pour réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenzaを再起動できませんでした。切り替えは元に戻されました。Cadenzaを終了して開き直し、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza가 자동으로 다시 시작되지 못했습니다. 전환이 취소되었습니다. 앱을 종료한 후 다시 열어 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cadenza 无法自动重启。切换已撤销——请退出并重新打开后重试。"
          }
        }
      }
    },
    "Cadenza couldn't start recording. Try again." : {
