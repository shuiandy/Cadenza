      }
    },
    "Live transcription interrupted. It will retry when the conversation resumes. Recording continues normally." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Transkription unterbrochen. Sie wird erneut versucht, sobald das Gespräch weitergeht. Die Aufnahme wird normal fortgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcripción en vivo se interrumpió. Se reintentará cuando se reanude la conversación. La grabación continúa con normalidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La transcription en direct est interrompue. Elle réessaiera dès que la conversation reprendra. L’enregistrement continue normalement."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ文字起こしが中断されました。会話が再開されると自動的に再試行されます。録音は通常どおり続行されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 전사가 중단되었습니다. 대화가 다시 시작되면 자동으로 재시도합니다. 녹음은 정상적으로 계속됩니다."
          }
        },
        "zh-Hans" : {
